{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "clarify-pm",
  "main": "packages/api/src/worker.ts",
  "compatibility_date": "2026-08-02",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "routes": [
    { "pattern": "clarify.pm", "custom_domain": true },
    { "pattern": "www.clarify.pm", "custom_domain": true },
    { "pattern": "api.clarify.pm", "custom_domain": true }
  ],
  "assets": {
    "directory": "packages/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*",
      "!/assets/*",
      "!/homepage/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "WORKSPACE",
        "class_name": "Workspace"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Workspace"
      ]
    }
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.sql"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "CORS_ORIGINS": "https://clarify.pm,https://www.clarify.pm,https://clarify-pm.thnkring.workers.dev",
    "AI_MODEL": "claude-sonnet-4-6"
  },
  "observability": {
    "enabled": true
  }
}
